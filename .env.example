# Copy to .env and fill in. See supabase/SUPABASE-SETUP.txt
# Supabase → Settings → API
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Band app calendar export (see supabase/BAND-SETUP.txt).
# Production value is set in the Cloudflare dashboard, not here.
BAND_ICAL_URL=

# Join form email via Resend (see supabase/EMAIL-SETUP.txt)
# RESEND_API_KEY=
# RESEND_FROM=
# JOIN_NOTIFY_EMAIL=

# WhatsApp Cloud API broadcast (see supabase/WHATSAPP-SETUP.txt)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en_US
